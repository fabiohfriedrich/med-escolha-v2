# Clerk (autenticação)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PostHog (analytics de produto) — sem essa key, PostHog não inicializa e fica sem tracking
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Anthropic (narrativa do resultado gerada por IA) — sem essa key, o app usa o texto template como fallback
ANTHROPIC_API_KEY=

# Resend (envio de e-mail)
RESEND_API_KEY=
EMAIL_FROM=
# Signing secret do webhook de entrega do Resend (resend.com/webhooks -> evento aponta pra
# /api/webhook/resend), usado pra verificar a assinatura via Svix
RESEND_WEBHOOK_SECRET=

# Beehiiv (newsletter)
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Hotmart (webhook de compra)
HOTMART_HOTTOK=
HOTMART_PRODUCT_ID_PSICOLOGO=
NEXT_PUBLIC_HOTMART_CHECKOUT_PSICOLOGO=

# Meta Conversions API (confirmação de Purchase server-side, complementa o Pixel client-side) — sem essa key, o webhook só loga aviso e segue normal
META_CAPI_ACCESS_TOKEN=

# GA4 Measurement Protocol (confirmação de purchase server-side) — sem essa key, o webhook só loga aviso e segue normal
GA4_MEASUREMENT_PROTOCOL_API_SECRET=

# Cal.com (agendamento das sessões com psicólogo)
CAL_COM_API_KEY=
CAL_COM_WEBHOOK_SECRET=
NEXT_PUBLIC_CAL_COM_BOOKING_LINK=

# Admin
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# Dashboard financeiro (/admin/financeiro) — gasto Meta Ads x receita Hotmart
# Meta: token de sistema com ads_read na conta act_692539635216356 (mesmo usado no diagnóstico diário de ads)
META_ADS_TOKEN=
# Hotmart: gerar em developers.hotmart.com > Ferramentas > Credenciais de acesso (escopo de vendas)
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=
HOTMART_BASIC_TOKEN=
# Opcional: lista de IDs de produto separados por vírgula, pra restringir a receita só aos produtos do Med Escolha
# (sem essa env, mostra todos os produtos vendidos pela conta Hotmart conectada)
HOTMART_PRODUCT_IDS=

# Cron (Vercel Cron Jobs)
CRON_SECRET=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App
NEXT_PUBLIC_APP_URL=
